DELAYLOAD_SUPPORTED=1
!ifndef DELAYLOAD_VERSION
DELAYLOAD_VERSION=0x0200
!endif

#
# ARM64 option control
#
UMBASE=$(UMBASE:*=arm64)
UMLIBS=$(UMLIBS:*=arm64)
NTRES=$(NTRES:*=arm64)
UMRES=$(UMRES:*=arm64)
UMOBJS=$(UMOBJS:*=arm64)
LINKLIBS=$(LINKLIBS:*=arm64)
GDI_DRIVER_LIBS=$(GDI_DRIVER_LIBS:*=arm64)
DLLBASE=$(DLLBASE:*=arm64)
DLLDEF=$(DLLDEF:*=arm64)
MACHINE_TARGETLIBS=$(MACHINE_TARGETLIBS:*=arm64)
!ifdef USE_MSHTML_PDB_RULES
MACHINE_TARGETLIBS=$(MACHINE_TARGETLIBS:????????=*)
!endif
TARGET=$(TARGET:*=arm64)
DYNLINK_LIB=$(DYNLINK_LIB:*=arm64)
TARGETEXEFILES=$(TARGETEXEFILES:*=arm64)
TARGETLIBFILES=$(TARGETLIBFILES:*=arm64)
TARGETOBJFILES=$(TARGETOBJFILES:*=arm64)
UMOBJFILES=$(UMOBJFILES:*=arm64)
UMEXEFILES=$(UMEXEFILES:*=arm64)
HEADERFILE=$(HEADERFILE:*=arm64)
HEADEROBJNAME=$(HEADEROBJNAME:*=arm64)
HEADEROBJ=$(HEADEROBJ:*=arm64)
PRECOMPILED=$(PRECOMPILED:*=arm64)
PRECOMPILED_CXX=$(PRECOMPILED_CXX:*=arm64)
PRECOMPILED_TARGET=$(PRECOMPILED_TARGET:*=arm64)
MFC_STATIC_LIB=$(MFC_STATIC_LIB:*=arm64)
CRT_LIB_PATH=$(CRT_LIB_PATH:*=arm64)
SDK_LIB_PATH=$(SDK_LIB_PATH:*=arm64)
DDK_LIB_PATH=$(DDK_LIB_PATH:*=arm64)
IFSKIT_LIB_PATH=$(IFSKIT_LIB_PATH:*=arm64)
HALKIT_LIB_PATH=$(HALKIT_LIB_PATH:*=arm64)
PROCESSOR_LIB_PATH=$(PROCESSOR_LIB_PATH:*=arm64)
ORDER=$(ORDER:*=arm64)
OBJLIBFILES=$(OBJLIBFILES:*=arm64)
MISCFILES=$(MISCFILES) $(ARM64_MISCFILES)
SOURCES=$(SOURCES) $(ARM64_SOURCES)

ADDITIONAL_ATL_LIBS = $(ADDITIONAL_ATL_LIBS) $(SDK_LIB_PATH)\atlarm64.lib

!ifdef NTTARGETFILES
NTTARGETFILES=$(NTTARGETFILES:*=arm64)
!endif
!ifdef NTTARGETFILE0
NTTARGETFILE0=$(NTTARGETFILE0:*=arm64)
!endif
!ifdef NTTARGETFILE1
NTTARGETFILE1=$(NTTARGETFILE1:*=arm64)
!endif

!ifdef PROJECT_LIB_PATH
PROJECT_LIB_PATH=$(PROJECT_LIB_PATH:*=arm64)
!endif

ENTRY_SUFFIX=
GDI_ENTRY_SUFFIX=

DEFAULT_STACKRESERVE=0x40000
DEFAULT_STACKCOMMIT=0x1000

ADDITIONAL_ATL_LIBS = $(ADDITIONAL_ATL_LIBS)

!IFDEF ARM64_WARNING_LEVEL
MSC_WARNING_LEVEL=$(ARM64_WARNING_LEVEL)
!ENDIF

MSC_WARNING_LEVEL=$(MSC_WARNING_LEVEL) $(COMPILER_WX_SWITCH)

!ifdef ARM64_PERFFLAGS
PERFFLAGS = $(ARM64_PERFFLAGS)
!endif

# Set MSC_OPTIMIZATION.
# Order of precedence:
#   Platform specific override
#   Environment variable
#   System Default

!if defined(ARM64_OPTIMIZATION)
MSC_OPTIMIZATION=$(ARM64_OPTIMIZATION)
!elseif !defined(MSC_OPTIMIZATION)
MSC_OPTIMIZATION=/Oxt
!endif

DBGFLAGS=$(DBGFLAGS) $(MSC_OPTIMIZATION)

WIN32_LIBS=$(WIN32_LIBS) $(LIBRARY_PATH)\ntdll.lib

!IFDEF ARM64_CPPFLAGS
MSC_CPPFLAGS=$(ARM64_CPPFLAGS)
!ENDIF

!ifdef NO_STRING_POOLING
STRING_POOLING =
!else
!ifdef NO_READONLY_STRINGS
STRING_POOLING = /Gf
!else
STRING_POOLING = /GF
!endif
!endif

!ifdef USE_NATIVE_EH
EH_FLAGS=/EHsc
!if "$(USE_NATIVE_EH)" == "ASYNC"
EH_FLAGS=/EHa
!endif
!else
EH_FLAGS=/EHs-c-
!endif

! ifdef USE_RTTI
RTTI_FLAGS=/GR
! else
RTTI_FLAGS=/GR-
! endif

!ifndef ARM64_CPU_OPTIMIZATION
ARM64_CPU_OPTIMIZATION=
!endif

STDFLAGS= /c /Zl /Zp8 /Gy /GS- $(CBSTRING) $(MSC_WARNING_LEVEL) $(MSC_CALL_TYPE) \
          $(ERATTA_FLAGS) $(ARM64_CPU_OPTIMIZATION) $(EH_FLAGS) \
          $(RTTI_FLAGS) $(STRING_POOLING)

!if $(FREEBUILD)
ASM_DBG_DEFINES=-DDBG=0
!else
ARM64_ADBGFLAGS=$(ARM64_ADBGFLAGS) -g
!endif


!ifndef USE_PDB_TO_COMPILE
DBGFLAGS=$(DBGFLAGS:/Zi=-Z7)
DBGFLAGS=$(DBGFLAGS:-Zi=-Z7)
!else
! ifndef USE_MSHTML_PDB_RULES
!  if "$(TARGETTYPE)" == "LIBRARY"
DBGFLAGS=$(DBGFLAGS) /Fd$(TARGETPATH)\$(TARGET_DIRECTORY)\$(TARGETNAME).pdb
!  else
DBGFLAGS=$(DBGFLAGS) /Fd$(MAKEDIR)\$(_OBJ_DIR)\ARM64^\
!  endif
! else
!  ifndef TARGETPDB
TARGETPDB=$(TARGETNAME)
!  endif
!  ifndef ROOT
ROOT=$(MAKEDIR)
!  endif
DBGFLAGS=$(DBGFLAGS) /Fd$(ROOT)\$(_OBJ_DIR)\arm64\$(TARGETPDB).pdb
! endif
!endif

!ifndef NO_BROWSER_INFO
! ifdef BROWSER_INFO
DBGFLAGS=$(DBGFLAGS) /FR$(MAKEDIR)\$(_OBJ_DIR)\arm64^\
! endif
!endif

#
# arm64 option control
#

!IF "$(HALTYPE)" == ""
HALDEF=
!ELSE
HALDEF=-D$(HALTYPE)=1
!ENDIF

STD_DEFINES=-D_WIN64 -D_ARM64_ -DARM64 $(HALDEF) $(MSC_CALL_DEFINE) $(STD_DEFINES)


CDEFINES=$(STD_DEFINES) $(TARGET_DBG_DEFINES) \
              $(LIBC_DEFINES) $(C_DEFINES) $(NET_C_DEFINES) $(MFC_DEFINES)
CFLAGS=$(ARM64_FLAGS) $(NTARM64FLAGS) $(STDFLAGS) $(DBGFLAGS) $(PERFFLAGS) $(USER_C_FLAGS)

#
# armasm64 has no C preprocessor, so ARM64 assembler sources are run through
# the C preprocessor first and the preprocessed output is assembled.
#

ARM64_ASMFLAGS=$(STD_DEFINES) $(ASM_DBG_DEFINES)\
              $(TARGET_DBG_DEFINES) $(ASM_DEFINES)

ARM64_CDEFINES=$(CDEFINES)
ARM64_CFLAGS=$(CFLAGS)

CC_NAME = cl -nologo

C_COMPILER_NAME     = $(CC_NAME)
CXX_COMPILER_NAME   = $(CC_NAME)
C_PREPROCESSOR_NAME = $(CC_NAME)
!ifndef ARM64_ASSEMBLER_NAME
ARM64_ASSEMBLER_NAME  = armasm64
!endif

GLOBAL_C_FLAGS = -Iarm64\ -I. $(INCPATH1) $(CDEFINES) $(CFLAGS)

NP_COMPILER_FLAGS = $(GLOBAL_C_FLAGS) $(COMPILER_WARNINGS)

C_COMPILER_FLAGS = $(NP_COMPILER_FLAGS) $(PRECOMPILED)
CXX_COMPILER_FLAGS = $(NP_COMPILER_FLAGS) $(PRECOMPILED_CXX) $(MSC_CPPFLAGS) $(NTCPPFLAGS)
C_PREPROCESSOR_FLAGS = $(GLOBAL_C_FLAGS) -EP -Tc

C_PREPROCESSOR = $(C_PREPROCESSOR_NAME) $(C_PREPROCESSOR_FLAGS)
C_ASM_PREPROCESSOR = $(C_PREPROCESSOR_NAME) $(ASM_DEFINES) $(C_PREPROCESSOR_FLAGS)
C_COMPILER     = $(C_COMPILER_NAME) $(C_COMPILER_FLAGS)
NP_C_COMPILER  = $(C_COMPILER_NAME) $(NP_COMPILER_FLAGS)
CXX_COMPILER   = $(CXX_COMPILER_NAME) $(CXX_COMPILER_FLAGS)

ARM64_ASM_PREPROCESSOR=$(C_PREPROCESSOR_NAME) -EP -Iarm64\ -I. $(INCPATH1) $(ARM64_ASMFLAGS) -Tc
ARM64_ASSEMBLER=$(ARM64_ASSEMBLER_NAME) -nologo $(ARM64_ADBGFLAGS)

ECHO_MSG=$(C_COMPILER) $<
ECHO_MSG_P=$(NP_C_COMPILER) $**
ECHO_CXX_MSG=$(CXX_COMPILER) $<

ECHO_PRECOMPILED_MSG1=$(C_COMPILER_NAME) $(C_COMPILER_FLAGS) /Yl$(TARGETNAME) /Yc$(?F) $(HEADERFILE) \
               $(HEADEROBJ) $(PRECOMPILED_FLAG) $(PRECOMPILED_SOURCEFILE)

ECHO_PRECOMPILED_MSG2=$(C_COMPILER_NAME) $(C_COMPILER_FLAGS) /Yl$(TARGETNAME) /Yc$(?F) $(HEADERFILE) \
               $(HEADEROBJ) $(PRECOMPILED_FLAG)

{}.c{}.asm:
    $(C_COMPILER_NAME) @<< /Fa $(MAKEDIR)\$(<F)
$(C_COMPILER_FLAGS: =
)
$(C_COMPILER_FLAGS:##= )
<<NOKEEP

{..\arm64\}.asm{}.pp:
    $(ARM64_ASM_PREPROCESSOR) $(MAKEDIR)\$< > $(MAKEDIR)\$@

{arm64\}.asm{}.pp:
    $(ARM64_ASM_PREPROCESSOR) $(MAKEDIR)\$< > $(MAKEDIR)\$@

{..\arm64\}.asm{}.lst:
    $(ARM64_ASM_PREPROCESSOR) $(MAKEDIR)\$< > $(MAKEDIR)\$(@R).pp
    $(ARM64_ASSEMBLER) -list $@ -o $(_OBJ_DIR)\arm64\$(@B).obj $(MAKEDIR)\$(@R).pp
    del $(MAKEDIR)\$(@R).pp

{arm64\}.asm{}.lst:
    $(ARM64_ASM_PREPROCESSOR) $(MAKEDIR)\$< > $(MAKEDIR)\$(@R).pp
    $(ARM64_ASSEMBLER) -list $@ -o $(MAKEDIR)\$(_OBJ_DIR)\arm64\$(@B).obj $(MAKEDIR)\$(@R).pp
    del $(MAKEDIR)\$(@R).pp

{..\arm64\}.asm{$(_OBJ_DIR)\arm64\}.obj:
    $(ARM64_ASM_PREPROCESSOR) $(MAKEDIR)\$< > $(MAKEDIR)\$(@R).pp
    $(ARM64_ASSEMBLER) -o $(MAKEDIR)\$@ $(MAKEDIR)\$(@R).pp
    del $(MAKEDIR)\$(@R).pp

{arm64\}.asm{$(_OBJ_DIR)\arm64\}.obj:
    $(ARM64_ASM_PREPROCESSOR) $(MAKEDIR)\$< > $(MAKEDIR)\$(@R).pp
    $(ARM64_ASSEMBLER) -o $(MAKEDIR)\$@ $(MAKEDIR)\$(@R).pp
    del $(MAKEDIR)\$(@R).pp

{$(O)\}.asm{$(O)\}.obj:
    $(ARM64_ASM_PREPROCESSOR) $(MAKEDIR)\$< > $(MAKEDIR)\$(@R).pp
    $(ARM64_ASSEMBLER) -o $(MAKEDIR)\$@ $(MAKEDIR)\$(@R).pp
    del $(MAKEDIR)\$(@R).pp

!IFDEF _NTARM64LIBS
_NTLIBS=$(_NTARM64LIBS)
!ENDIF

COPYDST=$(ARM64COPYDST)
LIB_COPY=ntarm64cp.cmd

!IF "$(NTDEBUGTYPE)" == "windbg" || "$(NTDEBUGTYPE)" == "both"
NTTEST_LINK_OPTIONS=-entry:KiSystemStartup
!ELSE
NTTEST_LINK_OPTIONS=-base:0x80100000 -entry:KiSystemStartup
!ENDIF

DRIVER_ALIGNMENT=0x1000
KERNEL_ALIGNMENT=0x1000
